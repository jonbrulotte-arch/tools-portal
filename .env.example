# ─────────────────────────────────────────────────────────────
# Tools Portal configuration. Copy to .env and fill in.
# .env is git-ignored: never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Address users open in their browser (used for sign-in redirects and invite links)
AUTH_URL=http://10.0.10.106:8016
APP_URL=http://10.0.10.106:8016
AUTH_TRUST_HOST=true

# Random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   (or: openssl rand -base64 32)
AUTH_SECRET=
# Encrypts stored API secrets (MS Graph, Shopify). Keep a copy somewhere safe:
# backups can only be fully used with the same key.
APP_ENCRYPTION_KEY=

# PostgreSQL (docker compose builds DATABASE_URL from these)
POSTGRES_DB=tools_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=
# Only when running outside docker compose (npm run dev):
# DATABASE_URL=postgresql://portal:password@localhost:5432/tools_portal
# BACKUP_DIR=./backups

# First administrator, created on first start if this email doesn't exist yet.
# Change the password after signing in (My Profile).
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_NAME=Portal Admin
SEED_ADMIN_PASSWORD=

# Optional Microsoft Graph defaults. Usually set in Admin → Settings → Email instead.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=no-reply@yourcompany.com

# Optional: host interface to publish port 8016 on (default: all interfaces)
# APP_BIND_ADDRESS=10.0.10.106
