generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & auth ─────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String
  passwordHash     String?
  status           UserStatus @default(INVITED)
  roleId           String
  role             Role       @relation(fields: [roleId], references: [id])
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  invitedById      String?
  invitedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  toolAccess   UserToolAccess[]
  inviteTokens InviteToken[]
  resetTokens  PasswordResetToken[]
  auditLogs    AuditLog[]
  discounts    ShopifyDiscount[]
  credentials  UserCredential[]
}

/// A user's own API credential for an outside service (e.g. Salsify), encrypted with APP_ENCRYPTION_KEY.
model UserCredential {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  encSecret String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── RBAC ─────────────────────────────────────────────────────

model Role {
  id           String           @id @default(cuid())
  name         String           @unique
  description  String           @default("")
  isSystem     Boolean          @default(false)
  isSuperAdmin Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  RolePermission[]
  toolAccess   RoleToolAccess[]
  users        User[]
}

model RolePermission {
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@id([roleId, permission])
}

model Tool {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String           @default("")
  usage       String           @default("")
  icon        String           @default("Wrench")
  enabled     Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roleAccess  RoleToolAccess[]
  userAccess  UserToolAccess[]
}

model RoleToolAccess {
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([roleId, toolId])
}

enum AccessEffect {
  GRANT
  DENY
}

model UserToolAccess {
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId String
  tool   Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  effect AccessEffect

  @@id([userId, toolId])
}

// ─── Audit log ────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  category   String
  targetType String?
  targetId   String?
  success    Boolean  @default(true)
  ip         String?
  userAgent  String?
  metadata   Json?

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([category])
}

// ─── Settings ─────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Asset {
  key       String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt
}

// ─── Tool: Shopify Discount Code Generator ───────────────────

enum ShopifyAuthType {
  ACCESS_TOKEN
  CLIENT_CREDENTIALS
}

model ShopifyStore {
  id                   String            @id @default(cuid())
  name                 String
  shopDomain           String            @unique
  authType             ShopifyAuthType
  encAccessToken       String?
  clientId             String?
  encClientSecret      String?
  encCachedToken       String?
  cachedTokenExpiresAt DateTime?
  apiVersion           String            @default("2026-10")
  currencyCode         String?
  enabled              Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  discounts            ShopifyDiscount[]
}

enum DiscountValueType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountRecordStatus {
  CREATED
  FAILED
}

model ShopifyDiscount {
  id                String               @id @default(cuid())
  storeId           String
  store             ShopifyStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByEmail    String?
  title             String
  valueType         DiscountValueType
  value             Decimal?             @db.Decimal(12, 2)
  codes             String[]
  config            Json
  shopifyDiscountId String?
  status            DiscountRecordStatus
  errorMessage      String?
  requestPayload    Json?
  responsePayload   Json?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime             @default(now())

  @@index([createdAt])
  @@index([storeId])
  @@index([createdById])
}

// ─── Tool: Shipping Rates Generator ──────────────────────────
// Uploaded ship-cost reports are reduced to aggregates; no names/addresses are stored.

enum ShippingJobStatus {
  PENDING
  RUNNING
  READY
  FAILED
  CANCELLED
}

model ShippingReport {
  id           String               @id @default(cuid())
  fileName     String
  uploadedById String?
  uploadedBy   String?
  status       ShippingJobStatus    @default(PENDING)
  error        String?
  progress     Int                  @default(0)
  rowCount     Int                  @default(0)
  dateFrom     DateTime?
  dateTo       DateTime?
  summary      Json?
  createdAt    DateTime             @default(now())
  finishedAt   DateTime?
  aggregates   ShippingHistoryAgg[]

  @@index([createdAt])
}

model ShippingHistoryAgg {
  id         String         @id @default(cuid())
  reportId   String
  report     ShippingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  carrier    String // UPS | USPS
  service    String // UPS: GROUND_COM | GROUND_RES ; USPS: GROUND_ADVANTAGE
  origin     String // origin code, e.g. LV | GV
  zone       Int
  zoneSource String // actual | ups-city | distance
  weight     Decimal        @db.Decimal(8, 2) // billed lb (UPS) / USPS tier in lb (0.25, 0.5, 0.75, 1, 2, ...)
  count      Int
  total      Decimal        @db.Decimal(12, 2)
  minCost    Decimal        @db.Decimal(10, 2)
  maxCost    Decimal        @db.Decimal(10, 2)

  @@index([reportId, carrier, origin, zone])
}

model ShippingQuoteRun {
  id          String            @id @default(cuid())
  mode        String // live | simulated
  status      ShippingJobStatus @default(PENDING)
  startedById String?
  startedBy   String?
  total       Int               @default(0)
  done        Int               @default(0)
  failed      Int               @default(0)
  error       String?
  config      Json
  createdAt   DateTime          @default(now())
  /// When the current pass began (a "Retry failed" pass starts a new one) and how many quotes were done before it.
  startedAt   DateTime?
  startDone   Int               @default(0)
  finishedAt  DateTime?
  quotes      ShippingQuote[]

  @@index([createdAt])
}

model ShippingQuote {
  id         String           @id @default(cuid())
  runId      String
  run        ShippingQuoteRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  carrier    String
  service    String
  origin     String
  zone       Int
  destZip    String
  weight     Decimal          @db.Decimal(8, 2)
  amount     Decimal?         @db.Decimal(10, 2)
  listAmount Decimal?         @db.Decimal(10, 2)
  apiZone    String?
  error      String?
  createdAt  DateTime         @default(now())

  @@index([runId, carrier, origin, zone])
}

// ─── Shipping Rates Generator: Products (weekly live rates for a Salsify list) ───

enum ProductRateItemStatus {
  OK
  NO_DATA
  FAILED
}

model ProductRateRun {
  id            String            @id @default(cuid())
  mode          String // live | simulated
  status        ShippingJobStatus @default(PENDING)
  startedById   String?
  startedBy     String?
  listId        String
  total         Int               @default(0)
  done          Int               @default(0)
  failed        Int               @default(0)
  error         String?
  comparedRunId String?
  createdAt     DateTime          @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  items         ProductRateItem[]

  @@index([createdAt])
}

model ProductRateItem {
  id           String                @id @default(cuid())
  runId        String
  run          ProductRateRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  position     Int
  partNumber   String
  name         String?
  packaging    String?
  weight       Decimal?              @db.Decimal(8, 2)
  length       Decimal?              @db.Decimal(8, 2)
  width        Decimal?              @db.Decimal(8, 2)
  height       Decimal?              @db.Decimal(8, 2)
  sizeSource   String? // primary | fallback | mixed
  upsBillable  Decimal?              @db.Decimal(8, 2)
  uspsBillable Decimal?              @db.Decimal(8, 2)
  status       ProductRateItemStatus
  error        String?
  createdAt    DateTime              @default(now())
  quotes       ProductRateQuote[]

  @@index([runId, partNumber])
  @@index([partNumber])
}

model ProductRateQuote {
  id         String          @id @default(cuid())
  itemId     String
  item       ProductRateItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  origin     String
  zone       Int
  carrier    String
  service    String
  destZip    String
  amount     Decimal?        @db.Decimal(10, 2)
  listAmount Decimal?        @db.Decimal(10, 2)
  negotiated Boolean?
  chart      Decimal?        @db.Decimal(10, 2)
  diffPct    Decimal?        @db.Decimal(8, 1)
  error      String?

  @@index([itemId])
}
